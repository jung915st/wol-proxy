import os
import csv
from flask import Flask, jsonify

# Path to the CSV file inside the container
TARGETS_CSV_PATH = '/data/targets.csv'

app = Flask(__name__)

def send_wol_packet(mac):
    """A helper function to send a single WoL packet and return its status."""
    command = f"wakeonlan {mac}"
    result = os.system(command)
    return result == 0

# Add this new route for basic testing
@app.route('/', methods=['GET'])
def index():
    return jsonify({
        "status": "ok",
        "message": "Welcome to the Wake-on-LAN Proxy! Use /wakeup/batch to send WoL packets."
    })

@app.route('/wakeup/<mac_address>', methods=['GET'])
def wakeup_single(mac_address):
    """Wakes up a single machine by its MAC address."""
    if not (12 <= len(mac_address) <= 17):
        return jsonify({"status": "error", "message": "Invalid MAC address format."}), 400
    
    if send_wol_packet(mac_address):
        print(f"Successfully sent WoL packet to {mac_address}")
        return jsonify({"status": "success", "message": f"WoL packet sent to {mac_address}"})
    else:
        print(f"Failed to send WoL packet to {mac_address}")
        return jsonify({"status": "error", "message": "Failed to execute wakeonlan command."}), 500

@app.route('/wakeup/batch', methods=['GET'])
def wakeup_batch():
    """
    Reads all MAC addresses from the CSV file and sends WoL packets to each.
    """
    successes = []
    failures = []

    try:
        with open(TARGETS_CSV_PATH, mode='r', newline='', encoding='utf-8-sig') as csvfile:

# Use a standard reader and skip the header row
            reader = csv.reader(csvfile)
            next(reader) # Skip the header row

            for i, row in enumerate(reader):
                # Ensure the row has enough columns
                if len(row) >= 3:
                    # Assume the MAC address is in the THIRD column (index 2)
                    mac = row[2].strip()
                    if mac:
                        if send_wol_packet(mac):
                            successes.append(mac)
                        else:
                            failures.append(mac)
                    else:
                        failures.append(f"Empty MAC address in row {i+2}")
                else:
                    failures.append(f"Row {i+2} does not have enough columns: {row}")

    except FileNotFoundError:
        print(f"Error: The file {TARGETS_CSV_PATH} was not found.")
        return jsonify({
            "status": "error",
            "message": f"Targets file not found at {TARGETS_CSV_PATH}."
        }), 500
    except Exception as e:
        print(f"An error occurred: {e}")
        return jsonify({"status": "error", "message": f"An error occurred while reading the CSV: {e}"}), 500

    print(f"Batch WoL complete. Success: {len(successes)}, Failed: {len(failures)}")
    return jsonify({
        "status": "complete",
        "sent_packets": len(successes),
        "failed_packets": len(failures),
        "successes": successes,
        "failures": failures
    })

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)
